# Database
DATABASE_URL="postgresql://pupbox:pupbox_secret@localhost:5432/pupbox_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# API
API_PORT=4000
API_PREFIX="api/v1"
NODE_ENV="development"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Public address of the API itself, used in links to uploaded images
API_BASE_URL="http://localhost:4000"
# Production behind Caddy: 1 (one proxy in front). Unset locally.
# TRUST_PROXY=1
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
# Google Maps for the address map (Maps JavaScript, Places and Geocoding APIs;
# restrict the key to your site's domain). Empty: OpenStreetMap is used instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Admin
ADMIN_PORT=3001
# The first super admin, created by `npm run db:seed`. Required in production;
# in development a random password is generated and printed once if unset.
ADMIN_EMAIL="admin@pupbox.ge"
ADMIN_PASSWORD=""

# Web
WEB_PORT=3000

# Storage (S3 compatible)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="pupbox-media"

# Email (Resend)
# Text messages (verification codes) — Wifisher, https://sms-api.wifisher.com
# SMS_PROVIDER: "wifisher" to send real SMS. WIFISHER_SENDER: the sender name Wifisher approved ("pupbox").
SMS_PROVIDER=""
WIFISHER_API_KEY=""
WIFISHER_SENDER="pupbox"
RESEND_API_KEY=""
EMAIL_FROM="noreply@pupbox.ge"

# Flitt Payment
FLITT_MERCHANT_ID=""
FLITT_SECRET_KEY=""
FLITT_API_URL="https://pay.flitt.com"
FLITT_WEBHOOK_SECRET=""
# Development only: with FLITT_MERCHANT_ID empty, "Pay" skips the bank and the
# order is marked paid at once. Set to "declined" to rehearse a refused card.
DEV_PAYMENT_RESULT="approved"

# S3 Public CDN URL
S3_PUBLIC_URL="https://media.pupbox.ge"
